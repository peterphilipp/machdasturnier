# === Pflicht ===
# JWT-Secret zum Signieren/Verifizieren der Tokens.
# MUSS gesetzt sein (mind. 16 Zeichen) – der Server startet sonst NICHT.
# Sicheres Secret erzeugen z.B. mit: openssl rand -hex 32
JWT_SECRET="bitte-durch-ein-langes-zufaelliges-secret-ersetzen"

# Prisma/SQLite Datenbank
DATABASE_URL="file:./prisma/data/dev.db"

# === Optional ===
# Basis-URL des Frontends (für Passwort-Reset-Links)
FRONTEND_URL="http://localhost:5173"

# E-Mail-Versand über Resend (Passwort-Reset). Ohne Key wird der Versand übersprungen.
# WICHTIG: Nur die hier eingetragene Absenderadresse ist bei Resend verifiziert -
# die eigentliche App-Domain (turnier-planer.mygate.dedyn.io) ist es NICHT,
# Versand mit einer anderen Absenderadresse schlägt fehl.
RESEND_API_KEY=""
EMAIL_FROM="Macht das Turnier! <noreply@mygate.dedyn.io>"
# Tageskontingent, ab dem sendeEinzelmail() nicht mehr versucht (siehe
# backend/src/utils/mailVersand.ts). Resends kostenloser Plan deckelt hart bei
# 100/Tag - Default 90 laesst etwas Puffer, weil Reminder/Bestaetigungen und
# Versandauftraege sich denselben Zaehler teilen.
RESEND_DAILY_LIMIT="90"

# Kommagetrennte E-Mails, die beim Login/Registrieren automatisch ADMIN werden
ADMIN_EMAILS="peter.philipp@example.com,admin@example.com"

# === Web-Push (VAPID) ===
# Generieren mit: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_MAILTO="mailto:noreply@example.com"
