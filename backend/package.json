{
  "name": "tsv-holm-backend",
  "version": "1.29.1",
  "type": "module",
  "scripts": {
    "start": "tsx --env-file=.env src/server.ts",
    "dev": "prisma generate && tsx watch --env-file=.env src/server.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:backup": "node --env-file=.env scripts/backup-db.cjs",
    "db:push": "npm run db:backup && prisma db push",
    "db:hash-pins": "node --env-file=.env scripts/migrate-hash-recovery-pins.cjs",
    "docs:datamodel": "node scripts/generate-datamodel-doc.cjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@simplewebauthn/server": "^13.3.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "resend": "^6.18.0",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/web-push": "^3.6.4",
    "prisma": "^5.10.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
